# Never commit a real Rime token.
RIME_API_TOKEN=
RIME_API_KEY=
RIME_ENDPOINT=wss://users.rime.ai/v1/rime-tts
RIME_MODEL=coda
RIME_VOICE=astra
RIME_LANGUAGE=en
RIME_AUDIO_FORMAT=pcm_s16le
RIME_SAMPLE_RATE=22050

# Optional LiveKit integration
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional LLM/STT provider configuration
LLM_MODEL=
STT_MODEL=

# Fixed fake-tool delay for the deterministic live demo.
VOICEGUARD_TOOL_DELAY=5.0
